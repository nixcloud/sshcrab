+    /// sshcrab patch: append `data` to the newest queued, not yet sent DATA
+    /// packet if it fits, instead of sending a packet of its own (like TCP's
+    /// send buffer). Small writes queued behind a full congestion window then
+    /// leave as a few full packets, not one tiny packet each. `None` = no
+    /// such packet; use [`Self::prepare_write`].
+    pub(crate) fn coalesce_write(&mut self, data: &[u8]) -> Option<oneshot::Receiver<Result<()>>> {
+        if data.is_empty() || self.ended || !self.connected {
+            return None;
+        }
+        let max_payload = self.max_payload();
+        let next_seq = self.next_seq;
+        let back = self.send_queue.back_mut()?;
+        // Only the newest packet (no FIN or other packet after it), a plain
+        // DATA packet without MTU-probe padding.
+        if back.seq.wrapping_add(1) != next_seq
+            || back.packet.len() < HEADER_SIZE
+            || back.packet[2] != FLAG_DATA
+            || back.packet[3] != 0
+            || back.packet.len() - HEADER_SIZE + data.len() > max_payload
+        {
+            return None;
+        }
+        back.packet.extend_from_slice(data);
+        let seq = back.seq;
+        let (ack_tx, ack_rx) = oneshot::channel();
+        self.pending_writes.push(PendingWrite {
+            ack_threshold: seq.wrapping_add(1),
+            tx: Some(ack_tx),
+        });
+        Some(ack_rx)
+    }
+
