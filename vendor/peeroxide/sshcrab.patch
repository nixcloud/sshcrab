+/// sshcrab patch: a connection's place in the swarm's `max_peers` count,
+/// given back when the connection is dropped. Upstream released it only when
+/// setting the connection up failed, so after `max_peers` connections a server
+/// accepted no more.
+struct Slot {
+    public_key: [u8; 32],
+    id: u64,
+    release: Option<mpsc::UnboundedSender<([u8; 32], u64)>>,
+}
+
+impl Drop for Slot {
+    fn drop(&mut self) {
+        if let Some(tx) = &self.release {
+            let _ = tx.send((self.public_key, self.id));
+        }
+    }
 }
 
